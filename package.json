{
  "name": "@sudobility/di_rn",
  "version": "0.1.164",
  "description": "React Native implementations of dependency injection services for Sudobility",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./info": {
      "types": "./dist/info/index.d.ts",
      "import": "./dist/info/index.js",
      "default": "./dist/info/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bunx tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx eslint src",
    "lint:fix": "bunx eslint src --fix",
    "format": "bunx prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "test:unit": "bunx vitest run",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@sudobility/di": "^1.5.78",
    "@sudobility/types": "^1.9.76",
    "react": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.72.0",
    "@sudobility/components-rn": "^1.0.128"
  },
  "peerDependenciesMeta": {
    "@sudobility/subscription_lib": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@notifee/react-native": "~9.1.8",
    "@react-native-community/netinfo": "~11.5.2",
    "@react-navigation/native": "~7.5.1",
    "@sudobility/components-rn": "^1.0.128",
    "@sudobility/di": "^1.5.78",
    "@sudobility/subscription_lib": "^0.0.56",
    "@sudobility/types": "^1.9.76",
    "@types/node": "~22.20.5",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "eslint": "~9.39.5",
    "eslint-plugin-prettier": "~5.5.7",
    "prettier": "~3.9.10",
    "typescript": "~5.9.3",
    "vitest": "~4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/di_rn.git"
  }
}
